# Access keys. They MUST be different, long, and random.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# For key rotation, multiple comma-separated keys are accepted.
AUDIODOC_AUDIO_KEY=
AUDIODOC_DOCUMENT_KEY=

# Local development only. Keep false on a server.
ALLOW_UNAUTHENTICATED=false

# Temporary files (default: <project directory>/tmp)
BACKEND_TEMP_DIR=

# Limits
MAX_AUDIO_SIZE=26214400
MAX_AUDIO_DURATION=600
MAX_CONCURRENT_TRANSCRIPTIONS=1
MAX_WAITING_DOCUMENTS=4
MAX_WAITING_TRANSCRIPTIONS=4

# Whisper
WHISPER_MODEL_SIZE=small
WHISPER_MODEL_PATH=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_OFFLINE=false
WHISPER_CPU_THREADS=6
WHISPER_LANGUAGE=ru
WHISPER_BEAM_SIZE=5
WHISPER_TIMEOUT=180

# Other
ENABLE_DOCS=false
LOG_LEVEL=INFO
