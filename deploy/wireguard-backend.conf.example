# /etc/wireguard/wg0.conf on machine B (backend + LLM).
# Generate the private key on B; replace placeholders locally. Never share it.
[Interface]
Address = 10.8.0.1/24
ListenPort = 51820
PrivateKey = <PRIVATE_KEY_OF_MACHINE_B>

[Peer]
# machine A (Telegram bot)
PublicKey = <PUBLIC_KEY_OF_MACHINE_A>
AllowedIPs = 10.8.0.2/32
