# Example snippet intended for nginx http{} context (map) and server{}.
# Replace the hostname, source address, and certificate paths.
map $http_x_request_id $media_backend_request_id {
    default $http_x_request_id;
    ""      $request_id;
}

server {
    listen 443 ssl;
    server_name backend.example.internal;

    ssl_certificate     /etc/ssl/media-backend/fullchain.pem;
    ssl_certificate_key /etc/ssl/media-backend/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Replace with the bot host's real egress/VPN source address.
    allow 203.0.113.10;
    deny all;

    client_max_body_size 60m;
    proxy_read_timeout 200s;
    proxy_connect_timeout 10s;
    proxy_send_timeout 200s;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $media_backend_request_id;
    }
}
