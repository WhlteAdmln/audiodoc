[Unit]
Description=Media Backend (Whisper + Document Engine)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
User=mediabackend
Group=mediabackend
WorkingDirectory=/opt/media-backend
EnvironmentFile=/opt/media-backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/media-backend/venv/bin/uvicorn app:app --host 10.8.0.1 --port 8000 --no-server-header
Restart=on-failure
RestartSec=5
UMask=0077

# Tune these values to the actual host; keep headroom for llama-server.
MemoryHigh=10G
MemoryMax=12G
CPUQuota=600%
TasksMax=256
Nice=10

# Process and filesystem sandbox.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/media-backend/tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallFilter=@system-service

# Example private subnet. Replace it if your VPN/network differs.
IPAddressDeny=any
IPAddressAllow=10.8.0.0/24 127.0.0.1

# For GPU inference, review PrivateDevices/DeviceAllow with your driver docs.

[Install]
WantedBy=multi-user.target
